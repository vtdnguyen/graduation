// Cloudflare Worker + D1 cho thiệp và hộp lời chúc tại /grad/.
// Route chỉ bắt /grad* → phần còn lại của vtdnguyen.com không bị ảnh hưởng.
// Deploy: npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vtdnguyen-grad",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/grad/api/*"],
    // scripts/prepare-deploy.mjs chép dist/ vào .deploy/grad/ để URL /grad/... khớp đường dẫn file
    "directory": "./.deploy",
    // /grad → /grad/ tự chuyển hướng
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "WISHES_DB",
    "database_name": "vtdnguyen-grad-wishes",
    "database_id": "ac3c77f4-4021-47bc-81f7-ff8280af2409",
    "migrations_dir": "migrations"
  }],
  "routes": [{ "pattern": "vtdnguyen.com/grad*", "zone_name": "vtdnguyen.com" }],
  "workers_dev": false
}
