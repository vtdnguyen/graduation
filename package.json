{
  "name": "grad-invitation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "dev:api": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 migrations apply WISHES_DB --local",
    "db:remote": "wrangler d1 migrations apply WISHES_DB --remote",
    "test:wishes": "node --test scripts/test-wishes-api.mjs && node scripts/test-wishes.mjs --no-shots",
    "gen:audio": "node scripts/gen-audio.mjs",
    "shots": "node scripts/shots.mjs",
    "og": "node scripts/og-image.mjs",
    "links": "node scripts/make-links.mjs",
    "deploy": "npm run build && node scripts/prepare-deploy.mjs && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "gsap": "^3.15.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0"
  }
}
